{
  "server": {
    "host": "0.0.0.0",
    "ports": [
      5000,
      5001
    ]
  },
  "thresholds": {
    "cpu_critical": 85,
    "memory_critical": 90
  },
  "heartbeat": {
    "timeout_sec": 6,
    "check_interval_sec": 1
  },
  "alerts": {
    "log_file": "/tmp/cn-integration/alerts.log"
  },
  "controller": {
    "enabled": true,
    "url": "http://10.0.0.100:8080/alert",
    "retries": 3,
    "retry_delay_sec": 1.0
  },
  "logging": {
    "report_csv": "/tmp/cn-integration/reports.csv",
    "event_csv": "/tmp/cn-integration/events.csv"
  }
}
